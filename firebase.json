{
    "hosting": {
        "public": ".",
        "rewrites": [
            {
                "source": "/api/**",
                "function": {
                    "functionId": "api",
                    "region": "asia-northeast1"
                }
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "functions": {
        "source": "functions"
    }
}