{
    "hosting": {
        "public": ".",
        "rewrites": [
            {
                "source": "/api/**",
                "function": {
                    "functionId": "api",
                    "region": "asia-northeast1"
                }
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ],
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**",
            "functions/**",
            "ref/**",
            "tests/**",
            "README.md"
        ]
    },
    "functions": {
        "source": "functions"
    }
}
